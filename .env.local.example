NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-publishable-key-from-supabase-status
# Optional explicit app URL used for auth redirects (signup confirmation + reset password links):
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional alias supported by the app:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key-from-supabase-status
# Required for push subscription storage and scheduled delivery (server-only):
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Web Push VAPID keys (`pnpm exec web-push generate-vapid-keys`):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
# Long random value shared with the Supabase Cron Vault secret as an Authorization bearer token:
CRON_SECRET=replace-with-a-long-random-secret
# Required for AI bulk-goal parsing / planner coach:
# GEMINI_API_KEY=your-google-ai-studio-key
# Optional model override (defaults to gemini-3.5-flash):
# GEMINI_MODEL=gemini-3.5-flash
# Calendar planner rollout capability (server-only). Default: true.
# Cross-month drag/move persistence (server-only). Default: false until dark-launched.
# FEATURE_CROSS_MONTH_MOVES=false
# Optional Sentry error tracking (omit locally; set in production):
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@o<orgId>.ingest.sentry.io/<projectId>
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=your-ci-auth-token
# Optional telemetry controls:
# PLANNER_TELEMETRY_HMAC_KEY=replace-with-at-least-32-chars
# PLANNER_TELEMETRY_HMAC_KEY_VERSION=1
# CALENDAR_TELEMETRY_COHORT=internal
# HMAC key used to sign read-only calendar feed tokens:
# CALENDAR_FEED_HMAC_KEY=replace-with-at-least-32-chars
