# Physical devices cannot reach 127.0.0.1 on your laptop.
# iOS: use your machine's LAN IP. Android emulator: 10.0.2.2.
# iOS ATS and Android 9+ block cleartext HTTP unless you add an exception.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-publishable-key-from-supabase-status
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# Optional Sentry DSN for mobile Duo telemetry/capture.
EXPO_PUBLIC_SENTRY_DSN=
# Optional Sentry environment tag (e.g. preview, production).
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
