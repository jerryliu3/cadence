    "test:sql": "tsx scripts/run-sql-tests.ts",
    "test:tz": "node scripts/run-timezone-tests.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types:supabase": "supabase gen types --local --schema public --schema private > src/lib/supabase/database.types.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset"
