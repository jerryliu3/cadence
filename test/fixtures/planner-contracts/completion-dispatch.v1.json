    },
    {
      "id": "fixed_goal_without_plan",
      "description": "A fixed goal outside active plans retains its existing non-planner mutation.",
      "input": {
        "requirementKind": "milestone_sequence",
        "targetedRecurring": false,
        "activePlanMembership": false,
        "matchingItemState": "none",
        "selectedDateState": "today",
        "existingExactFact": false,
        "desiredFactState": "present"
      },
      "expected": {
        "route": "legacy_period",
        "exactDateOnly": false,
        "allowed": true,
        "reason": "legacy_period_semantics"
      }
    }
  ]
}
